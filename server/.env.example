# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# JWT signing secret - use a long random value in production
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret

# Stripe test keys for the public demo
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# OpenAI admin agent - server side only, never expose this key in React or Flutter
OPENAI_API_KEY=sk-proj-replace_me
OPENAI_MODEL=gpt-5.4-mini

# Deployed React admin origin, without a trailing slash
ADMIN_ORIGIN=https://your-admin.example.com

# Runtime
NODE_ENV=production
PORT=3000

# Used only when running: npm run admin:create
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters
ADMIN_NAME=Demo Admin
