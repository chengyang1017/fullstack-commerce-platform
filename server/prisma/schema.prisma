generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum InventoryMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PROCESSING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ShippingMethod {
  STANDARD
  EXPRESS
}

enum PaymentMethod {
  ONLINE_BANKING
  CARD
  CASH_ON_DELIVERY
}

model Category {
  id        String   @id
  name      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([isActive, sortOrder])
}

model Product {
  id            String   @id
  categoryId    String
  title         String
  description   String
  imageUrl      String
  priceMinor    Int
  stock         Int
  reservedStock Int      @default(0)
  sold          Int
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category           Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  inventoryMovements InventoryMovement[]
  orderItems         OrderItem[]

  @@index([categoryId])
  @@index([isActive])
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  role         UserRole   @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  refreshTokens      RefreshToken[]
  inventoryMovements InventoryMovement[]
  orders             Order[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model InventoryMovement {
  id              String                @id @default(cuid())
  productId       String
  type            InventoryMovementType
  quantityDelta   Int
  stockBefore     Int
  stockAfter      Int
  note            String?
  createdByUserId String?
  createdAt       DateTime              @default(now())

  product       Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdByUser User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([createdByUserId])
  @@index([type])
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  userId        String
  status        OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus PaymentStatus @default(UNPAID)
  currency      String        @default("MYR")

  shippingMethod  ShippingMethod @default(STANDARD)
  paymentMethod   PaymentMethod  @default(ONLINE_BANKING)
  paymentIntentId String?        @unique

  subtotalMinor Int
  shippingMinor Int @default(0)
  discountMinor Int @default(0)
  totalMinor    Int

  recipientName  String
  recipientPhone String
  addressLine1   String
  addressLine2   String?
  city           String
  state          String
  postalCode     String
  countryCode    String  @default("MY")

  customerNote         String?
  paidAt               DateTime?
  cancelledAt          DateTime?
  reservationExpiresAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items OrderItem[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([status, reservationExpiresAt])
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  productId       String
  productTitle    String
  productImageUrl String
  unitPriceMinor  Int
  quantity        Int
  lineTotalMinor  Int
  createdAt       DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
  @@index([productId])
}
